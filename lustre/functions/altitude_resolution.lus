-- altitude_resolution.lus
include "../common/daidalus_types.lus"

contract altitude_resolution_contract (
    altitude_bands : DAIDALUS_Bands;
) returns (found : resolution);
let
    guarantee "Altitude Resolution R1.
    The altitude resolution results in an acceptable action, a revert 
    behavior, or problem was improperly configured. /n "
    (
        (found = acceptable_action) or (found = revert_behavior) or 
        (found = improperly_configured)
    );
tel


node imported altitude_resolution (altitude_bands : DAIDALUS_Bands) returns 
(found : resolution);
(*@contract 
  import altitude_resolution_contract(altitude_bands) returns (found);
*)
