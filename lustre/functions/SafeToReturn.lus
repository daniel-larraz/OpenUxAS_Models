--SafeToReturn.lus
include "../common/daidalus_types.lus"

contract SafeToReturnContract (
    waypoint : next_waypoint;
) returns (IsSafeToReturn : bool);
let
    guarantee "SafeToReturn returns true when the next waypoint is not in the 
    NEAR altitude, heading, or groundspeed bands provided by DAIDALUS detection."
    (
        IsSafeToReturn =>
        ((waypoint.altitude = safe) and (waypoint.heading = safe) and 
        (waypoint.speed = safe))
    );
tel.

node SafeToReturn (waypoint : next_waypoint) returns (IsSafeToReturn : bool);
(*@contract 
import SafeToReturnContract(waypoint) returns (IsSafeToReturn);
*)
let
    --next waypoint is only checked if there is a mission waypoint to return to
    IsSafeToReturn = if ((waypoint.altitude = safe) and 
    (waypoint.heading = safe) and (waypoint.speed = safe)) then true else
    false;

    check (waypoint.altitude = safe and waypoint.heading = safe and waypoint.
           speed = safe ) provided (IsSafeToReturn);
tel.


