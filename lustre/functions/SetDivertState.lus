-- SetDivertState.lus

--include "../common/types.lus"
include "../common/daidalus_types.lus"
include "../functions/altitude_resolution.lus"
include "../functions/heading_resolution.lus"
include "../functions/speed_resolution.lus"

contract SetDivertStateContract (
    altitude_bands : resolution;
    heading_bands : resolution;
    speed_bands : resolution;
    )
    returns 
    (
        resolution_quality : quality;
    );

let
    guarantee "SetDivertState SDR1.
    SetDivertState will either return an acceptable altitude divert, an 
    acceptable heading divert, an acceptable groundspeed divert, a fallback
    behavior, or a no recourse due to improper configuration/mis call. /n "
    (
        (resolution_quality = divert_altitude_successful) or 
        (resolution_quality = divert_heading_successful) or 
        (resolution_quality = divert_speed_successful) or
        (resolution_quality = fallback) or (resolution_quality = no_recourse)
    );
tel.

node SetDivertState (
    altitude_bands : resolution;
    heading_bands : resolution;
    speed_bands : resolution
) returns (resolution_quality : quality);
(*@contract import SetDivertStateContract(altitude_bands, heading_bands, 
speed_bands) returns (resolution_quality);*)
let

tel;
