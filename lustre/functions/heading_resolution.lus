-- heading_resolution.lus
include "../common/daidalus_types.lus"

contract heading_resolution_contract (
    heading_bands : DAIDALUS_Bands;
) returns (found : resolution);
let
    guarantee "Heading Resolution R1.
    The heading resolution results in an acceptable action, a revert 
    behavior, or problem was improperly configured. /n "
    (
        (found = acceptable_action) or (found = revert_behavior) or 
        (found = improperly_configured)
    );
tel


node imported heading_resolution (heading_bands : DAIDALUS_Bands) returns 
(found : resolution);
(*@contract 
  import heading_resolution_contract(heading_bands) returns (found);
*)
